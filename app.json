{
  "expo": {
    "scheme": "jageer",
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jageer needs access to your photos so you can attach pictures of the issue to a service request."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jageer needs your location to attach it to a service request so a technician can find you."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Jageer needs access to your contacts so you can quickly fill in a customer's name and phone number when creating a job."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Jageer uses Face ID to quickly and securely unlock the app."
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Jageer needs microphone access so you can add Finance entries by voice."
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-asset"
    ],
    "name": "jageer-app",
    "slug": "jageer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.jageerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.anonymous.jageerapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55d39a89-72c8-4ffa-aec8-c0423c67443e"
      }
    },
    "owner": "ai-biztech-nepal",
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/55d39a89-72c8-4ffa-aec8-c0423c67443e",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
